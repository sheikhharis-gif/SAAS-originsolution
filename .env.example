# Local MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=saas_master_db

# Dummy token checked by the local mock WhatsApp webhook only
WHATSAPP_WEBHOOK_TOKEN=local-dev-whatsapp-token

# Flask session signing key
FLASK_SECRET_KEY=

# PythonAnywhere deploy (only needed to run deploy/pythonanywhere.py) - unused
# now that hosting is a VPS, kept only in case it's ever needed again.
PA_USERNAME=
PA_API_TOKEN=
# Directory name under /home/<PA_USERNAME>/ where the code lives on PythonAnywhere
PA_REMOTE_DIR=mysite

# Automated per-client VPS deploy (projects/vps_deploy.py). DEPLOY_DOMAIN needs
# a wildcard DNS A record (*.yourdomain.com -> the VPS IP) already set up.
DEPLOY_DOMAIN=originsolutions.com
DEPLOY_ADMIN_EMAIL=
CLIENT_APPS_DIR=/srv/client-apps
DEPLOY_PORT_RANGE_START=6000
DEPLOY_PORT_RANGE_END=6999
